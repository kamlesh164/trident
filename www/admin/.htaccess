# Disable directory listing
Options -Indexes

# Enable rewriting
RewriteEngine On
RewriteBase /admin/

# Default file for /admin/
DirectoryIndex login.php

# Allow direct access to existing files or folders (CSS, JS, images, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# --- Clean URLs: remove .php from visible address ---
# Redirect from file.php → /file
RewriteCond %{THE_REQUEST} \s([^.]+)\.php[\s?] [NC]
RewriteRule ^ %1 [R=302,L]

# Internally map /file → file.php
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]

# --- Default behavior when accessing /admin directly ---
# If someone goes to /admin or /admin/
RewriteRule ^$ login [L]
